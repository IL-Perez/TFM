title "Final odds-ratio table -- Origination and Monitoring, Standard ML and Firth";
proc print data=work.final_or_table noobs;
    var View Method Variable Comparison OddsRatio LowerCL UpperCL Reliability;
    format OddsRatio LowerCL UpperCL 8.4;
run;
title;

title "Final performance table -- Origination and Monitoring, Standard ML and Firth";
proc print data=work.final_perf_table noobs;
run;
title;

ods pdf close;

/* 14. Final row-count assertions across BOTH views combined */
proc sql noprint;
    select count(*) into :n_or_total trimmed from work.final_or_table;
    select count(*) into :n_perf_total trimmed from work.final_perf_table;
quit;

%macro final_checks;
    %if &n_or_total ^= 22 %then %do;
    %put WARNING: Final odds-ratio table row count is &n_or_total; expected 22.;
%end;
    %if &n_perf_total ^= 4 %then
        %put WARNING: FINAL PERFORMANCE TABLE DOES NOT HAVE 4 ROWS.;
%mend final_checks;
%final_checks;

/* 15. Export final tables to CSV */
proc export data=work.final_or_table
    outfile="&or_csv_path"
    dbms=csv
    replace;
run;

proc export data=work.final_perf_table
    outfile="&perf_csv_path"
    dbms=csv
